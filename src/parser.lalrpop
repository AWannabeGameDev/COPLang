use std::range::Range;

use lalrpop_util::ParseError;

use crate::lexer::*;
use crate::ast::*;

grammar<'s, 'e>(errors: &'e mut Vec<ParseError<usize, Token<'s>, ()>>);

extern 
{
    type Location = usize;
    type Error = ();

    enum Token<'s> 
    {
        "[" => Token::LeftSqr,
        "]" => Token::RightSqr,
        "{" => Token::LeftBrace,
        "}" => Token::RightBrace,
        "(" => Token::LeftParen,
        ")" => Token::RightParen,
        ";" => Token::Semicolon,
        ":" => Token::Colon,
        "," => Token::Comma,
        "." => Token::Dot,
        "?" => Token::Question,

        "+" => Token::Plus,
        "-" => Token::Minus,
        "/" => Token::ForSlash,
        "*" => Token::Star,

        "=" => Token::Eq,
        "==" => Token::EqEq,
        "!" => Token::Bang,
        "!=" => Token::BangEq,
        ">" => Token::Greater,
        ">=" => Token::GreaterEq,
        "<" => Token::Lesser,
        "<=" => Token::LesserEq,
        "&&" => Token::And,
        "||" => Token::Or,

        "Int" => Token::Int,
        "Float" => Token::Float,
        "Bool" => Token::Bool,
        "print" => Token::Print,
        "struct" => Token::Struct,
        "if" => Token::If,
        "else" => Token::Else,
        "while" => Token::While,
        "break" => Token::Break,
        "continue" => Token::Continue,
        "let" => Token::Let,
        "fn" => Token::Fn,

        "iden" => Token::Identifier(<&'s [u8]>),
        "literal" => Token::Literal(<Literal>),

        "<err>" => Token::Error
    }
}

pub PROG: StmtBlock<'s> =
{
    <block:BLOCK> => block
}

BLOCK: StmtBlock<'s> =
{
    <stmts:STMT*> => StmtBlock(stmts)
}

IFELSE: IfElseBlock<'s> =
{
    "if" <cond:ASSN> "{" <block:BLOCK> "}" <els:ELSE> => IfElseBlock {cond, block, els}
}

ELSE: ElseBlock<'s> =
{
    => ElseBlock::None,
    "else" "{" <block:BLOCK> "}" => ElseBlock::Else(block),
    "else" <ifelse:IFELSE> => ElseBlock::ElseIf(Box::new(ifelse))
}

STMT: Stmt<'s> =
{
    <start:@L> "let" <id:"iden"> ":" <typ:TYPE> "=" <expr:ASSN> ";" <end:@R> => Stmt {span: Range {start, end}, data: StmtEnum::Decl(typ, id, expr)},
    <start:@L> "fn" <id:"iden"> "(" <typs:COMMALIST<(<"iden"> ":" <TYPE>)>> ")" ":" <out:TYPE> <end:@R> "{" <block:BLOCK> "}" => Stmt {span: Range {start, end}, data: StmtEnum::FnDecl(id, typs, out, block)},
    <start:@L> <expr:ASSN> ";" <end:@R> => Stmt {span: Range {start, end}, data: StmtEnum::Expr(expr)},
    <start:@L> "{" <block:BLOCK> "}" <end:@R> => Stmt {span: Range {start, end}, data: StmtEnum::Block(block)},
    <start:@L> <ifelse:IFELSE> <end:@R> => Stmt {span: Range{start, end}, data: StmtEnum::Cond(ifelse)},
    <start:@L> "while" <cond:ASSN> "{" <block:BLOCK> "}" <end:@R> => Stmt {span: Range{start, end}, data: StmtEnum::Iter(cond, block)},
    <start:@L> "break" ";" <end:@R> => Stmt {span: Range {start, end}, data: StmtEnum::Break},
    <start:@L> "continue" ";" <end:@R> => Stmt {span: Range {start, end}, data: StmtEnum::Continue},
    <start:@L> <err:!> ";" <end:@R> =>
    {
        errors.push(err.error);
        Stmt {span: Range {start, end}, data: StmtEnum::Error}
    },
    <start:@L> <err:"<err>"> <end:@R> => Stmt {span: Range {start, end}, data: StmtEnum::Error}
}

COMMALIST<T>: Vec<T> =
{
    <mut vec:(<T> ",")*> <last:T?> => match last
    {
        None => vec,
        Some(t) => {vec.push(t); vec}
    }
}

TYPE: VarType =
{
    <c:ATOM> => VarType::Atom(c),
    "[" "]" => VarType::Unit
}

ATOM: AtomType =
{
    "Int" => AtomType::Int,
    "Float" => AtomType::Float,
    "Bool" => AtomType::Bool,
}

ASSN: Expr<'s> =
{
    <start:@L> <l:TERN> "=" <r:ASSN> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Assign, vec![l, r])},
    <e:TERN> => e
}

TERN: Expr<'s> =
{
    <start:@L> <p:LOG> "?" <i:TERN> ":" <e:TERN> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Ternary, vec![p, i, e])},
    <e:LOG> => e
}

LOG: Expr<'s> =
{
    <start:@L> <l:LOG> "&&" <r:EQ> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::And, vec![l, r])},
    <start:@L> <l:LOG> "||" <r:EQ> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Or, vec![l, r])},
    <e:EQ> => e
}

EQ: Expr<'s> =
{
    <start:@L> <l:EQ> "==" <r:INEQ> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::EqualTo, vec![l, r])},
    <start:@L> <l:EQ> "!=" <r:INEQ> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::NotEqualTo, vec![l, r])},
    <e:INEQ> => e
}

INEQ: Expr<'s> =
{
    <start:@L> <l:INEQ> ">" <r:ADD> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Greater, vec![l, r])},
    <start:@L> <l:INEQ> "<" <r:ADD> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Lesser, vec![l, r])},
    <start:@L> <l:INEQ> ">=" <r:ADD> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::GreaterEq, vec![l, r])},
    <start:@L> <l:INEQ> "<=" <r:ADD> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::LesserEq, vec![l, r])},
    <e:ADD> => e
}

ADD: Expr<'s> =
{
    <start:@L> <l:ADD> "+" <r:FACT> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Add, vec![l, r])},
    <start:@L> <l:ADD> "-" <r:FACT> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Sub, vec![l, r])},
    <e:FACT> => e
}

FACT: Expr<'s> =
{
    <start:@L> <l:FACT> "*" <r:UN> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Mul, vec![l, r])},
    <start:@L> <l:FACT> "/" <r:UN> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Div, vec![l, r])},
    <e:UN> => e
}

UN: Expr<'s> =
{
    <start:@L> "!" <e:UN> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Not, vec![e])},
    <start:@L> "-" <e:UN> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Negate, vec![e])},
    <start:@L> "print" <e:UN> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Print, vec![e])},
    <e:GRP> => e
}

GRP: Expr<'s> =
{
    "(" <e:ASSN> ")" => e,
    <start:@L> <id:"iden"> "(" <args:COMMALIST<ASSN>> ")" <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Op(Operation::Func(id), args)},
    <e:ENTLIT> => e,
    <start:@L> <e:"iden"> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Identifier(e)}
}

ENTLIT: Expr<'s> =
{
    <start:@L> <e:"literal"> <end:@R> => Expr {span: Range {start, end}, data: ExprEnum::Literal(e)}
}
fn ackermann(m: Int, n: Int) : Int {
    if m == 0 {
        return n + 1;
    }
    if m > 0 && n == 0 {
        return ackermann(m - 1, 1);
    }
    return ackermann(m - 1, ackermann(m, n - 1));
}

let result: Int = ackermann(4, 2);
print result; // Should heavily churn the stack and eventually print 125
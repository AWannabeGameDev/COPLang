let x: Int = 0;

// TRAP 1: Root-level break
break;

if x == 0 {
    // TRAP 2: Continue inside an 'if', but no enclosing loop
    continue;
}

while x < 5 {
    if x == 3 {
        // This is perfectly legal and should NOT throw an error.
        break;
    }
    x = x + 1;
}

{
    // TRAP 3: Break inside an arbitrary block, no loop
    break;
}
fn compute(x: Int, flag: Bool) : [] {
    if flag {
        print x;
    }
}

// TRAP 1: Arity mismatch (Too few arguments)
compute(5);

// TRAP 2: Parameter type mismatch (Expected Bool, found Int)
compute(10, 10);

// TRAP 3: Calling an undeclared function
phantom_call(100);

// TRAP 4: Calling a standard variable as if it were a function
let rogue_var: Int = 77;
rogue_var(5);
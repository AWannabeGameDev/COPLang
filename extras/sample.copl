fn sort(arr: [Int; 10]): [Int; 10]
{
    let sorted: Int = 1;

    while sorted < 10
    {
        let idx: Int = sorted;

        while idx > 0
        {
            if arr[idx - 1] <= arr[idx] {break;}
            let tmp: Int = arr[idx];
            arr[idx] = arr[idx - 1];
            arr[idx - 1] = tmp;
            idx = idx - 1;
        }

        sorted = sorted + 1;
    }

    return arr;
}

fn print_array(arr: [Int; 10]): []
{
    let idx: Int = 0;
    while idx < 10 {print arr[idx]; idx = idx + 1;}
    print 10000000;
    return ();
}

let arr: [Int; 10.5];
let idx: Int = 0;
while idx < 10
{
    if idx % 2 == 0 {arr[idx] = 10 - idx;}
    else {arr[idx] = idx;}
    idx = idx + 1;
}

print_array(arr);
arr = sort(arr);
print_array(arr);
